---
import Layout from '~/layouts/LandingLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import { getPermalink } from '../utils/permalinks';

const metadata = {
  title: 'Bulwark Bookworks',
};

const callToActionSubtitle = "<p>We publish tales forged in conflict and conviction</p>";
---

<Layout metadata={metadata}>
  <!-- Hero2 Widget ******************* -->

  <Hero2
    tagline="Stories that hold the line"
    title="Bulwark Bookworks — Coming Soon"
    subtitle="Bulwark Bookworks is an independent publishing collective built on trust, privacy, and ethics. We’re preparing to launch a three-part suite of services designed to help authors build and protect their creative work: a publisher-in-trust service for author safety, a growing library of tools and courses to support independent publishing, and a partnership matchmaking program connecting writers with vetted, trustworthy professionals. Every part of Bulwark Bookworks is designed around one principle—help authors publish safely, ethically, and on their own terms."
    actions={[
      //{ variant: 'primary', text: 'Join the Vanguard', href: getPermalink('/join/vanguard') },
      //{ text: 'Learn more', href: getPermalink('/about-us') },
    ]}
    image={{
      src: '/images/hero/pexels-mali-101708.jpg',
      alt: 'Typewriter. It starts with one WORD',
    }}
    imageFlavor='wide'
  />
</Layout>
