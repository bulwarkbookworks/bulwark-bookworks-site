---
import { SITE } from 'astrowind:config';
import { Image } from 'astro:assets';
import theLogo from '../assets/favicons/logo-light.webp';
---
<span class="flex items-center">
  <Image
    src={theLogo}
    alt={SITE?.name ? `${SITE.name} logo` : 'site logo'}
    width={32}
    height={32}
    class="mr-2 object-contain"
  />

  <span
    class="self-center ml-2 rtl:ml-0 rtl:mr-2 text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white"
  >
    {SITE?.name}
  </span>
</span>
